#!/bin/bash
set -ex

SCRIPT_DIR="$(pwd)"
WORK_DIR="/overlayfs/desktop-layers-work-$$"

# /overlayfs is a Docker volume that outlives the build: drop what a build
# that failed left there, nothing reuses it.
rm -rf --one-file-system /overlayfs/desktop-layers-work-*

# Base filesystem
OVERLAY_LOWER="../chroot"

# $1: desktop name. $2: install script, run in the chroot after
# config/desktops/$1 (if it exists) is copied in.
create_desktop_layer() {
	local DESKTOP_NAME="$1"
	local INSTALL_SCRIPT="$2"
	local OVERLAY_UPPER="${WORK_DIR}/${DESKTOP_NAME}/upper"
	local OVERLAY_WORK="${WORK_DIR}/${DESKTOP_NAME}/work"
	local OVERLAY_MOUNT="${WORK_DIR}/${DESKTOP_NAME}/merged"

	# Create working directories
	mkdir -p "${OVERLAY_UPPER}" "${OVERLAY_WORK}" "${OVERLAY_MOUNT}"
		
	# Create overlay filesystem
	mount -t overlay overlay \
		-o "lowerdir=${OVERLAY_LOWER},upperdir=${OVERLAY_UPPER},workdir=${OVERLAY_WORK}" \
		"${OVERLAY_MOUNT}"
	
	# Setup chroot environment
	mount -t proc none "${OVERLAY_MOUNT}/proc"
	mount -t sysfs none "${OVERLAY_MOUNT}/sys"
	mount --rbind /dev "${OVERLAY_MOUNT}/dev"
	mount --rbind /run "${OVERLAY_MOUNT}/run"
	mount --bind /etc/resolv.conf "${OVERLAY_MOUNT}/etc/resolv.conf"

	# Desktop-specific files
	if [ -d "../config/desktops/${DESKTOP_NAME}" ]; then
		cp -r "../config/desktops/${DESKTOP_NAME}/." "${OVERLAY_MOUNT}/"
	fi

	# Install the desktop
	chroot "${OVERLAY_MOUNT}" /bin/bash -c "
		set -e
		export DEBIAN_FRONTEND=noninteractive
		${INSTALL_SCRIPT}
	"

	# Kill any remaining processes in chroot
	fuser -km "${OVERLAY_MOUNT}" || true
	sleep 1
	umount -R -l "${OVERLAY_MOUNT}" 2>/dev/null || true

	# Cleanup unecessary files
	rm -f "${OVERLAY_UPPER}"/var/cache/apt/archives/*.deb "${OVERLAY_UPPER}"/boot/initrd.img-*

	# Create desktop squashfs
	mkdir -p desktops
	mksquashfs "${OVERLAY_UPPER}" "desktops/${DESKTOP_NAME}-desktop.squashfs" -comp zstd -noappend

	# Images live-boot stacks with "module=${DESKTOP_NAME}"
	printf 'filesystem.squashfs\n../desktops/%s-desktop.squashfs\n' "${DESKTOP_NAME}" > "live/filesystem.${DESKTOP_NAME}.module"

	# --one-file-system: never descend into a mount the umount above left.
	rm -rf --one-file-system "${WORK_DIR:?}/${DESKTOP_NAME}"
}

# Create layers for each desktop environment
create_desktop_layer "gnome" "apt-get install -y task-gnome-desktop"
create_desktop_layer "kde" "apt-get install -y task-kde-desktop"
create_desktop_layer "xfce" "apt-get install -y task-xfce-desktop"

# DankMaterialShell on niri with the DMS greeter (greetd), from DankLinux's
# OBS: stable builds on trixie, -git ones after.
# https://danklinux.com/docs/dankmaterialshell/installation/
. ../config/bootstrap
if [ "${LB_DISTRIBUTION}" = trixie ]; then
	DANK_OBS=Debian_13 DANK_GIT=
else
	DANK_OBS=Debian_Testing DANK_GIT=-git
fi

DANK_REPOS=https://downloadcontent.opensuse.org/repositories/home:/AvengeMedia:

create_desktop_layer "dank" "
	printf 'Types: deb\nURIs: %s\nSuites: /\nSigned-By: /etc/apt/keyrings/avengemedia.asc\n\n' \
		${DANK_REPOS}/danklinux/${DANK_OBS}/ ${DANK_REPOS}/dms${DANK_GIT}/${DANK_OBS}/ \
		> /etc/apt/sources.list.d/danklinux.sources
	apt-get update
	apt-get install -y dms${DANK_GIT} dms-greeter${DANK_GIT} niri ghostty firefox-esr \
		network-manager pipewire-audio xdg-user-dirs xwayland x11-xserver-utils \
		gnome-shell- budgie-desktop- gnome-settings-daemon-
	install -d -o nobody /tmp/skel
	setpriv --reuid=nobody --regid=nogroup --clear-groups env HOME=/tmp/skel SYSTEMD_OFFLINE=1 sh -c '
		dms setup headless --compositor niri --terminal ghostty &&
		systemctl --user add-wants niri.service dms'
	cp -a --no-preserve=ownership /tmp/skel/. /etc/skel/
	rm -rf /tmp/skel
	test -L /etc/skel/.config/systemd/user/niri.service.wants/dms.service
"
